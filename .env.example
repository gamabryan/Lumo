# Lumo — variáveis de ambiente
# Copie este arquivo para .env.local e preencha com os valores do seu projeto Supabase:
#   cp .env.example .env.local
#
# Onde encontrar (Supabase Dashboard):
#   Project Settings → API  OU  botão Connect
#   - Project URL
#   - anon / publishable key  (NÃO use a service_role no frontend)

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_OR_PUBLISHABLE_KEY
